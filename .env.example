APP_NAME=BimbelPro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# Untuk MySQL (Laragon):
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bimbelpro
DB_USERNAME=root
DB_PASSWORD=

# Untuk SQLite (simple):
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_COOKIE=bimbelpro-session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@bimbelpro.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS (opsional) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Vite ---
VITE_APP_NAME="${APP_NAME}"

# --- BimbelPro Seeder Credentials ---
# Isi dengan email & password yang kamu inginkan untuk akun seed awal.
# Jangan gunakan password yang sama di production!
BIMBELPRO_ADMIN_NAME="Admin BimbelPro"
BIMBELPRO_ADMIN_EMAIL=admin@bimbelpro.com
BIMBELPRO_ADMIN_PASSWORD=

BIMBELPRO_TUTOR_NAME="Tutor BimbelPro"
BIMBELPRO_TUTOR_EMAIL=tutor@bimbelpro.com
BIMBELPRO_TUTOR_PASSWORD=

# --- Laravel Boost (dev tool) ---
BOOST_BROWSER_LOGS_WATCHER=false